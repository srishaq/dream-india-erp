{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/((?!dashboard|ca$|ca\\.html|accounts$|accounts\\.html|site$|site\\.html|purchase$|purchase\\.html|drawings$|drawings\\.html|hr$|hr\\.html).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(dashboard|ca|accounts|site|purchase|drawings|hr)(.html)?",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' https://cdnjs.cloudflare.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?job=morning",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron?job=bank",
      "schedule": "40 9 * * *"
    },
    {
      "path": "/api/cron?job=pdc",
      "schedule": "50 3 * * *"
    },
    {
      "path": "/api/cron?job=mail",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/oauth/google",
      "destination": "/api/custdocs?oauth=callback"
    },
    {
      "source": "/api/me",
      "destination": "/api/portal"
    },
    {
      "source": "/api/hr",
      "destination": "/api/portal?hr=1"
    },
    {
      "source": "/(crm|finance|audit|construction|training|home|management)",
      "destination": "/"
    }
  ]
}
